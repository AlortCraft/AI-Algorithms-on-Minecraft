.venv/
__pycache__/
*.pyc
tmp/

# Backups locais dos mundos e do servidor
Servidor-BOT/backups/

# Arquivos temporarios e dependencias geradas pelo PaperMC
Servidor-BOT/cache/
Servidor-BOT/libraries/
Servidor-BOT/logs/
Servidor-BOT/versions/
Servidor-BOT/plugins/.paper-remapped/
Servidor-BOT/.console_history
Servidor-BOT/.directory
Servidor-BOT/usercache.json

# Travas temporarias: nunca devem ser compartilhadas entre computadores
Servidor-BOT/world_*/session.lock

# Os demais dados dos mundos sao versionados intencionalmente, inclusive
# inventarios, posicoes, estatisticas e avancos dos jogadores.

# Modelos, checkpoints e registros de treinamento
*.pt
*.pth
*.ckpt
events.out.tfevents.*
resultados/modelos/
resultados/metricas/
resultados/graficos/

# Configuracoes locais e segredos
.env
config/bot.json
